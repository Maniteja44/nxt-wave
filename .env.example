# ---- Pick ONE provider for the writer --------------------------------------
# anthropic | openai | gemini | groq | bedrock | ollama
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash-lite          # optional - defaults per provider in lessongen/config.py

# ---- Optional: a different model as the judge (recommended if you have one) -
JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gpt-4.1

# ---- Keys (only the one you use) -------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GEMINI_API_KEY=        # free key: https://aistudio.google.com/apikey
JUDGE_MODEL=gemini-2.5-flash
# GROQ_API_KEY=          # free key: https://console.groq.com/keys
# Bedrock uses your normal AWS credentials (aws configure / env vars):
# AWS_REGION=us-east-1
# LLM_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# ---- Loop settings ---------------------------------------------------------
MAX_RETRIES=2            # 0-2. Max evaluations = 1 + MAX_RETRIES
JUDGE_WORKERS=1          # parallel LLM judges (lower this if you hit rate limits)
LLM_TEMPERATURE=0.7      # writer only; judges always run at temperature 0
